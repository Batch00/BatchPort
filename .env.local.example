# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# Supabase -- shared Batch Apps project (supabase.com dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend -- resend.com dashboard
RESEND_API_KEY=re_your-resend-api-key

# App URL -- http://localhost:3000 locally, https://batchport.batch-apps.com in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin email -- where access request notifications are sent
BATCHPORT_ADMIN_EMAIL=you@example.com

# Secret used to sign approval/deny tokens (generate with: openssl rand -hex 32)
APPROVAL_SECRET=your-random-secret

# Map -- PMTiles dark basemap URL (Supabase Storage or /public path)
NEXT_PUBLIC_PMTILES_URL=

# Geocoding -- contact string sent as User-Agent header to Nominatim (server only)
NOMINATIM_USER_AGENT=BatchPort/1.0 (your-email@example.com)
